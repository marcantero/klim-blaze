{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KLIM Blaze",
  "version": "0.1.0",
  "identifier": "com.klim.blaze.configurator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KLIM Blaze",
        "width": 1120,
        "height": 740,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#09090b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "KLIM Blaze mouse configurator",
    "longDescription": "A lightweight desktop configurator for the KLIM Blaze Wireless Gaming Mouse: RGB lighting, DPI stages, polling rate and profiles."
  }
}
